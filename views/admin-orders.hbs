
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Order Management</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 30px 20px;
            font-family: Arial, sans-serif;
            color: white;
            background: #080d1c;
        }

        .container {
            max-width: 1100px;
            margin: auto;
            padding: 25px;
            background: #111930;
            border-radius: 15px;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        button, select {
            padding: 10px 14px;
            border: none;
            border-radius: 7px;
            cursor: pointer;
        }

        button {
            background: #6366f1;
            color: white;
        }

        .order-card {
            margin-top: 20px;
            padding: 20px;
            background: #0c1429;
            border: 1px solid #303c59;
            border-radius: 12px;
        }

        .order-card p {
            color: #cbd5e1;
        }

        .order-item {
            padding: 12px;
            margin: 10px 0;
            background: #182440;
            border-radius: 8px;
        }

        .status-controls {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 15px;
        }

        select {
            background: #182440;
            color: white;
            border: 1px solid #475569;
        }

        .status {
            color: #a5b4fc;
            font-weight: bold;
        }

        #message {
            margin-top: 15px;
        }

        @media(max-width: 600px) {
            .container {
                padding: 15px;
            }
        }
        .order-item {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 12px;
    margin: 10px 0;
    background: #182440;
    border-radius: 8px;
}
.product-image {
    width: 100px;
    height: 100px;
    object-fit: cover;
    border-radius: 8px;
}
.product-details {
    flex: 1;
}
.order-item {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 15px;
    margin: 12px 0;
    background: rgb(105, 60, 43);
    border: 1px solid #303c59;
    border-radius: 12px;
    transition: 0.3s;
}
.order-item:hover {
    background: #202e4c;
}
.product-image {
    width: 110px;
    height: 110px;
    object-fit: contain;
    background: white;
    padding: 5px;
    border-radius: 10px;
    flex-shrink: 0;
}

.product-details {
    flex: 1;
}

.product-details p {
    margin: 7px 0;
    font-size: 14px;
    color: #cbd5e1;
}

.product-details p:first-child {
    font-size: 17px;
    font-weight: bold;
    color: white;
}

@media (max-width: 600px) {
    .order-item {
        gap: 12px;
        padding: 10px;
    }

    .product-image {
        width: 80px;
        height: 80px;
    }

    .product-details p:first-child {
        font-size: 15px;
    }
}
    </style>
</head>
<body>
<div class="container">
    <header>
        <h1>Order Management</h1>
        <button onclick="window.location.href='/product-page'">
            Back to Products
        </button>
    </header>
    <p id="message"></p>
    <div id="ordersContainer"></div>
</div>
<script>
    const ordersContainer = document.getElementById("ordersContainer");
    const message = document.getElementById("message");

    async function api(url, options = {}) {
        const response = await fetch(url, {
    ...options,
    credentials: "same-origin",
    headers: {
        ...options.headers,
        ...(options.body ? {
            "Content-Type": "application/json"
        } : {})
    },
    body: options.body
        ? JSON.stringify(options.body)
        : undefined
});
        const data = await response.json().catch(() => ({}));

        if (!response.ok) {
            throw new Error(data.message || "Request failed");
        }

        return data;
    }

async function loadOrders() {
    try {
        const data = await api("/orders/");
        const ordersContainer = document.getElementById("ordersContainer");

        ordersContainer.innerHTML = "";

        if (!data.orders || data.orders.length === 0) {
            ordersContainer.textContent = "No orders found.";
            return;
        }

        data.orders.forEach(order => {
            const card = document.createElement("div");
            card.className = "order-card";

            const heading = document.createElement("h3");
            heading.textContent = `Order ID: ${order._id}`;

            const customer = document.createElement("p");
            customer.textContent =
                `Customer: ${order.user?.name || "N/A"} (${order.user?.email || "N/A"})`;

            const date = document.createElement("p");
            date.textContent =
                `Date: ${new Date(order.createdAt).toLocaleString()}`;

            const total = document.createElement("p");
            total.textContent = `Total Amount: ₹${order.totalAmount}`;

            const payment = document.createElement("p");
            payment.textContent =
                `Payment: ${order.paymentMethod} | ${order.paymentStatus}`;

            const status = document.createElement("p");
            status.textContent = `Order Status: ${order.orderStatus}`;

            card.append(
                heading,
                customer,
                date
            );

            const productsHeading = document.createElement("h4");
            productsHeading.textContent = "Products:";
            card.appendChild(productsHeading);

            order.items.forEach(item => {
    const itemDiv = document.createElement("div");
    itemDiv.className = "order-item";

    const productImage = document.createElement("img");

    const product = item.product;

    if (product && product.images && product.images.length > 0) {
        productImage.src = `/${product.images[0].replace(/^\//, "")}`;
        productImage.alt = item.name;
    } else {
        productImage.src = "/images/no-image.png";
        productImage.alt = "No image available";
    }

    productImage.className = "product-image";

    const details = document.createElement("div");
    details.className = "product-details";

    const productName = document.createElement("p");
    productName.textContent = `Product: ${item.name}`;

    const productPrice = document.createElement("p");
    productPrice.textContent = `Price: ₹${item.price}`;

    const quantity = document.createElement("p");
    quantity.textContent = `Quantity: ${item.quantity}`;

    details.append(productName, productPrice, quantity);

    itemDiv.append(productImage, details);

    card.appendChild(itemDiv);
});

            card.append(total, payment, status);

            const addressHeading = document.createElement("h4");
            addressHeading.textContent = "Shipping Address";

            const addressDetails = document.createElement("p");
            const address = order.shippingAddress;

            addressDetails.textContent =
                `${address.fullName}, ${address.phone}, ${address.addressLine}, ${address.city}, ${address.state} - ${address.pincode}`;

            card.append(addressHeading, addressDetails);

            // Admin can cancel eligible orders
            if (["PENDING", "CONFIRMED"].includes(order.orderStatus)) {
                const cancelButton = document.createElement("button");

                cancelButton.textContent = "Cancel Order";
                cancelButton.style.background = "#dc2626";
                cancelButton.style.color = "white";

                cancelButton.addEventListener("click", () => {
                    console.log(order._id);
                    cancelAdminOrder(order._id);
                });

                card.appendChild(cancelButton);
            }
            if (["PENDING", "CONFIRMED", "SHIPPED"].includes(order.orderStatus)) {
                const controls = document.createElement("div");
                controls.className = "status-controls";

                const select = document.createElement("select");

                const statuses = ["CONFIRMED", "SHIPPED", "DELIVERED"];

                statuses.forEach(value => {
                    const option = document.createElement("option");
                    option.value = value;
                    option.textContent = value;

                    if (value === order.orderStatus) {
                        option.selected = true;
                    }

                    select.appendChild(option);
                });

                const updateButton = document.createElement("button");
                updateButton.textContent = "Update Status";

                updateButton.addEventListener("click", () => {
                    updateOrderStatus(order._id, select.value);
                });

                controls.append(select, updateButton);
                card.appendChild(controls);
            }

            ordersContainer.appendChild(card);
        });

    } catch (error) {
        alert(error.message);
    }
}

    async function updateOrderStatus(orderId, orderStatus) {
        try {
            await api(`/orders/${orderId}/status`, {
                method: "PATCH",
                body: { orderStatus }
            });

            alert("Order status updated successfully!");
            await loadOrders();

        } catch (error) {
            alert(error.message);
        }
    }
    async function cancelAdminOrder(orderId) {
    const confirmed = confirm(
        "Are you sure you want to cancel this order?"
    );
    if (!confirmed) {
        return;
    }
    try {
        const data = await api(`/orders/${orderId}/cancel`, {
            method: "PATCH"
        });

        alert(data.message);
        await loadOrders();

    } catch (error) {
        alert(error.message);
    }
}

    loadOrders();
</script>

</body>
</html>
