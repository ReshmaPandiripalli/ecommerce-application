<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Wishlist</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 30px;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #101326, #251b3d);
            color: white;
            min-height: 100vh;
        }

        .container {
            max-width: 1100px;
            margin: auto;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            flex-wrap: wrap;
            margin-bottom: 25px;
        }

        h1 {
            margin: 0;
            color: #ffffff;
        }

        button {
            border: none;
            padding: 10px 16px;
            border-radius: 7px;
            cursor: pointer;
            font-size: 14px;
            font-weight: bold;
        }

        .back-btn {
            background: #64748b;
            color: white;
        }

        .wishlist-count {
            color: #c4b5fd;
            margin-bottom: 20px;
        }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
            gap: 22px;
        }

        .product-card {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 12px;
            padding: 16px;
            overflow: hidden;
        }

        .product-card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
            border-radius: 8px;
            background: #ffffff;
        }

        .product-card h3 {
            margin: 14px 0 8px;
        }

        .product-card p {
            color: #d1d5db;
            margin: 7px 0;
        }

        .price {
            color: #a78bfa !important;
            font-size: 18px;
            font-weight: bold;
        }

        .remove-btn {
            width: 100%;
            margin-top: 12px;
            background: #dc2626;
            color: white;
        }

        .remove-btn:hover {
            background: #b91c1c;
        }

        .empty-message {
            text-align: center;
            padding: 50px 15px;
            color: #cbd5e1;
            font-size: 18px;
        }

        .status {
            margin-bottom: 15px;
            color: #c4b5fd;
        }
    </style>
</head>

<body>

    <div class="container">

        <div class="header">
            <h1>My Wishlist ❤️</h1>

            <button class="back-btn" onclick="goBack()">
                Back to Products
            </button>
        </div>

        <p class="wishlist-count" id="wishlistCount">
            Loading wishlist...
        </p>

        <p class="status" id="status"></p>

        <div class="product-grid" id="wishlistProducts"></div>

    </div>

    <script>

        const wishlistProducts = document.getElementById("wishlistProducts");
        const wishlistCount = document.getElementById("wishlistCount");
        const statusMessage = document.getElementById("status");


        // API helper
        async function api(url, options = {}) {

            async function sendRequest() {

                const headers = {
                    ...options.headers
                };

                if (options.body !== undefined &&
                    !(options.body instanceof FormData)) {
                    headers["Content-Type"] = "application/json";
                }

                return fetch(url, {
                    ...options,
                    headers,
                    credentials: "same-origin",
                    body: options.body === undefined
                        ? undefined
                        : options.body instanceof FormData
                            ? options.body
                            : JSON.stringify(options.body)
                });
            }

            let response = await sendRequest();

            if (response.status === 401) {

                const refreshResponse = await fetch("/auth/new-access-token", {
                    method: "POST",
                    credentials: "same-origin"
                });

                if (refreshResponse.ok) {
                    response = await sendRequest();
                }
            }

            const data = await response.json();

            if (!response.ok) {
                throw new Error(data.message || "Something went wrong");
            }

            return data;
        }


        // Load wishlist
        async function loadWishlist() {

            try {

                statusMessage.textContent = "Loading...";

                const data = await api("/wishlist");

                // Backend returns { message, products }
                const products = data.products || [];

                renderWishlist(products);

                statusMessage.textContent = "";

            } catch (err) {

                console.error("Wishlist error:", err);

                statusMessage.textContent = err.message;
                wishlistCount.textContent = "Unable to load wishlist";
            }
        }


        // Display wishlist products
        function renderWishlist(products) {

            wishlistProducts.innerHTML = "";

            wishlistCount.textContent =
                `Total Wishlist Products: ${products.length}`;

            if (products.length === 0) {

                wishlistProducts.innerHTML = `
                    <div class="empty-message">
                        <h2>Your wishlist is empty ❤️</h2>
                        <p>Add products to your wishlist to see them here.</p>
                    </div>
                `;

                return;
            }

            products.forEach(product => {

                const card = document.createElement("div");
                card.className = "product-card";

                const image = document.createElement("img");

                image.src = product.images && product.images.length > 0
                    ? product.images[0]
                    : "";

                image.alt = product.name || "Product image";

                const heading = document.createElement("h3");
                heading.textContent = product.name || "Unnamed Product";

                const category = document.createElement("p");
                category.textContent =
                    `Category: ${product.category || "N/A"}`;

                const price = document.createElement("p");
                price.className = "price";
                price.textContent = `₹${product.price}`;

                const quantity = document.createElement("p");
                quantity.textContent =
                    `Quantity: ${product.quantity ?? "N/A"}`;

                const removeButton = document.createElement("button");
                removeButton.className = "remove-btn";
                removeButton.textContent = "Remove from Wishlist";

                removeButton.addEventListener("click", () => {
                    removeFromWishlist(product._id);
                });

                card.appendChild(image);
                card.appendChild(heading);
                card.appendChild(category);
                card.appendChild(price);
                card.appendChild(quantity);
                card.appendChild(removeButton);

                wishlistProducts.appendChild(card);
            });
        }


        // Remove product from wishlist
        async function removeFromWishlist(productId) {

            const confirmDelete = confirm(
                "Are you sure you want to remove this product from your wishlist?"
            );

            if (!confirmDelete) {
                return;
            }

            try {

                await api(
                    `/wishlist/remove/${encodeURIComponent(productId)}`,
                    {
                        method: "DELETE"
                    }
                );

                statusMessage.textContent =
                    "Product removed from wishlist";

                await loadWishlist();

            } catch (err) {

                console.error("Remove wishlist error:", err);

                statusMessage.textContent = err.message;
            }
        }


        // Navigate back
        function goBack() {
            window.location.href = "/product-page";
        }


        // Initial loading
        loadWishlist();

    </script>

</body>
</html>