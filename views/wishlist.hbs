
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Wishlist</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 30px;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #101326, #251b3d);
            color: white;
            min-height: 100vh;
        }

        .container {
            max-width: 1200px;
            margin: auto;
        }

        /* Header */

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            flex-wrap: wrap;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid rgba(255,255,255,0.15);
        }

        h1 {
            margin: 0;
            color: #ffffff;
            font-size: 30px;
        }

        button {
            border: none;
            padding: 12px 18px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            font-weight: bold;
            transition: 0.3s ease;
        }

        .back-btn {
            background: #64748b;
            color: white;
        }

        .back-btn:hover {
            background: #475569;
            transform: translateY(-2px);
        }

        /* Wishlist Count */

        .wishlist-count {
            color: #c4b5fd;
            margin-bottom: 20px;
            font-size: 16px;
            font-weight: bold;
        }

        .status {
            margin-bottom: 15px;
            color: #c4b5fd;
        }

        /* Product Grid */

        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 25px;
        }

        /* Product Card */

        .product-card {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 15px;
            padding: 18px;
            overflow: hidden;
            transition: 0.3s ease;
            display: flex;
            flex-direction: column;
        }

        .product-card:hover {
            transform: translateY(-6px);
            background: rgba(255, 255, 255, 0.12);
            border-color: #a78bfa;
            box-shadow: 0 8px 25px rgba(0,0,0,0.3);
        }

        .product-card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-radius: 10px;
            background: #ffffff;
            transition: 0.3s ease;
        }

        .product-card h3 {
            margin: 16px 0 10px;
            font-size: 19px;
            color: #ffffff;
        }

        .product-card p {
            color: #d1d5db;
            margin: 7px 0;
            font-size: 14px;
        }

        .price {
            color: #c4b5fd !important;
            font-size: 22px !important;
            font-weight: bold;
            margin-top: 12px !important;
        }

        /* Action Buttons */

        .buy-now-btn {
            width: 100%;
            margin-top: 15px;
            background: #65968f;
            color: white;
        }

        .buy-now-btn:hover {
            background: #c2410c;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(234,88,12,0.3);
        }

        .remove-btn {
            width: 100%;
            margin-top: 10px;
            background: #dc2626;
            color: white;
        }

        .remove-btn:hover {
            background: #b91c1c;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(220,38,38,0.3);
        }

        /* Empty Wishlist */

        .empty-message {
            text-align: center;
            padding: 60px 20px;
            color: #cbd5e1;
            font-size: 18px;
            grid-column: 1 / -1;
            background: rgba(255,255,255,0.05);
            border-radius: 15px;
            border: 1px dashed rgba(255,255,255,0.2);
        }

        .empty-message h2 {
            color: #c4b5fd;
            margin-bottom: 15px;
        }

        /* Responsive Design */

        @media (max-width: 600px) {

            body {
                padding: 20px 15px;
            }

            h1 {
                font-size: 24px;
            }

            .header {
                flex-direction: column;
                align-items: flex-start;
            }

            .back-btn {
                width: 100%;
            }

            .product-grid {
                grid-template-columns: 1fr;
                gap: 18px;
            }

            .product-card img {
                height: 220px;
            }
        }

    </style>
</head>

<body>

    <div class="container">

        <div class="header">
            <h1>My Wishlist ❤️</h1>

            <button class="back-btn" onclick="goBack()">
                Back to Products
            </button>
        </div>

        <p class="wishlist-count" id="wishlistCount">
            Loading wishlist...
        </p>

        <p class="status" id="status"></p>

        <div class="product-grid" id="wishlistProducts"></div>

    </div>

    <script>

        const wishlistProducts = document.getElementById("wishlistProducts");
        const wishlistCount = document.getElementById("wishlistCount");
        const statusMessage = document.getElementById("status");


        // API helper
        async function api(url, options = {}) {

            async function sendRequest() {

                const headers = {
                    ...options.headers
                };

                if (options.body !== undefined &&
                    !(options.body instanceof FormData)) {
                    headers["Content-Type"] = "application/json";
                }

                return fetch(url, {
                    ...options,
                    headers,
                    credentials: "same-origin",
                    body: options.body === undefined
                        ? undefined
                        : options.body instanceof FormData
                            ? options.body
                            : JSON.stringify(options.body)
                });
            }

            let response = await sendRequest();

            if (response.status === 401) {

                const refreshResponse = await fetch("/auth/new-access-token", {
                    method: "POST",
                    credentials: "same-origin"
                });

                if (refreshResponse.ok) {
                    response = await sendRequest();
                }
            }

            const data = await response.json();

            if (!response.ok) {
                throw new Error(data.message || "Something went wrong");
            }

            return data;
        }


        // Load wishlist
        async function loadWishlist() {

            try {

                statusMessage.textContent = "Loading...";

                const data = await api("/wishlist");

                const products = data.products || [];

                renderWishlist(products);

                statusMessage.textContent = "";

            } catch (err) {

                console.error("Wishlist error:", err);

                statusMessage.textContent = err.message;
                wishlistCount.textContent = "Unable to load wishlist";
            }
        }


        // Display wishlist products
        function renderWishlist(products) {

            wishlistProducts.innerHTML = "";

            wishlistCount.textContent =
                `Total Wishlist Products: ${products.length}`;

            if (products.length === 0) {

                wishlistProducts.innerHTML = `
                    <div class="empty-message">
                        <h2>Your wishlist is empty ❤️</h2>
                        <p>Add products to your wishlist to see them here.</p>
                    </div>
                `;

                return;
            }

            products.forEach(product => {

                const card = document.createElement("div");
                card.className = "product-card";

                const image = document.createElement("img");

                image.src = product.images && product.images.length > 0
                    ? product.images[0]
                    : "";

                image.alt = product.name || "Product image";

                const heading = document.createElement("h3");
                heading.textContent = product.name || "Unnamed Product";

                const category = document.createElement("p");
                category.textContent =
                    `Category: ${product.category || "N/A"}`;

                const price = document.createElement("p");
                price.className = "price";
                price.textContent = `₹${product.price}`;

                const quantity = document.createElement("p");
                quantity.textContent =
                    `Quantity: ${product.quantity ?? "N/A"}`;

                const buyNowButton = document.createElement("button");
                buyNowButton.className = "buy-now-btn";
                buyNowButton.textContent = "Buy Now";

                buyNowButton.addEventListener("click", () => {
                    window.location.href =
                        `/checkout-page?buyNow=${product.productId}`;
                });

                const removeButton = document.createElement("button");
                removeButton.className = "remove-btn";
                removeButton.textContent = "Remove from Wishlist";

                removeButton.addEventListener("click", () => {
                    removeFromWishlist(product._id);
                });

                card.appendChild(image);
                card.appendChild(heading);
                card.appendChild(category);
                card.appendChild(price);
                card.appendChild(quantity);
                card.appendChild(buyNowButton);
                card.appendChild(removeButton);

                wishlistProducts.appendChild(card);
            });
        }


        // Remove product from wishlist
        async function removeFromWishlist(productId) {

            const confirmDelete = confirm(
                "Are you sure you want to remove this product from your wishlist?"
            );

            if (!confirmDelete) {
                return;
            }

            try {

                await api(
                    `/wishlist/remove/${encodeURIComponent(productId)}`,
                    {
                        method: "DELETE"
                    }
                );

                statusMessage.textContent =
                    "Product removed from wishlist";

                await loadWishlist();

            } catch (err) {

                console.error("Remove wishlist error:", err);

                statusMessage.textContent = err.message;
            }
        }
        function goBack() {
            window.location.href = "/product-page";
        }

        loadWishlist();

    </script>

</body>
</html>