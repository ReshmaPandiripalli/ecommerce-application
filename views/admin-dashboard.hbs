<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        * {
            box-sizing: border-box;
        }
        .container {
            max-width: 1100px;
            margin: 30px auto;
            padding: 25px;
        }

        .dashboard-buttons {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin: 25px 0;
        }

        #usersList {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .user-card {
            background: #ffffff;
            border: 1px solid #ddd;
            border-radius: 12px;
            padding: 22px;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .user-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
        }

        .user-card h3 {
            margin: 0 0 15px;
            color: #222;
        }

        .user-card p {
            margin: 10px 0;
            color: #555;
            overflow-wrap: anywhere;
        }

        .user-card select {
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 6px;
            margin-top: 15px;
            margin-right: 8px;
        }

        .user-card button {
            padding: 10px 14px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            background: #4b55c5;
            color: white;
            margin: 5px 4px 0 0;
        }

        .user-card button:hover {
            background: #353e9e;
        }

        .user-card button.danger {
            background: linear-gradient(135deg, #dc3545, #be123c);
        }

        #usersSection,
        #productsSection {
            margin-top: 30px;
        }

        @media (max-width: 600px) {
            .container {
                margin: 10px;
                padding: 15px;
            }

            .dashboard-buttons {
                flex-direction: column;
            }

            .dashboard-buttons button {
                width: 100%;
            }
        }
    </style>
</head>

<body>
    <div class="container">

        <h1>Admin Dashboard</h1>
        <p>Welcome, Admin!</p>

        <div class="dashboard-buttons">
            <button id="manageUsers">Manage Users</button>
            <button id="manageProducts">Manage Products</button>
            <button id="logout">Logout</button>
        </div>

        <div id="usersSection" hidden>
            <h2>Manage Users</h2>
            <div id="usersList"></div>
        </div>

        <div id="productsSection" hidden>
            <h2>Manage Products</h2>
            <div id="productsList"></div>
        </div>

    </div>

    <script>
        const manageUsers = document.getElementById("manageUsers");
        const manageProducts = document.getElementById("manageProducts");
        const usersSection = document.getElementById("usersSection");
        const productsSection = document.getElementById("productsSection");
        const usersList = document.getElementById("usersList");
        manageProducts.addEventListener("click", () => {
            window.location.href = "/product-page";
        });
        async function loadUsers() {
            try {
                const response = await fetch("/admin/users", {
                    credentials: "same-origin"
                });

                const users = await response.json();

                if (!response.ok) {
                    throw new Error(users.message || "Failed to fetch users");
                }

                usersSection.hidden = false;
                productsSection.hidden = true;
                usersList.innerHTML = "";
                if (users.length === 0) {
                    usersList.textContent = "No users found.";
                    return;
                }
                users.forEach(user => {
                    const userCard = document.createElement("div");
                    userCard.className = "user-card";

                    userCard.innerHTML = `
                        <h3>${user.name || "No Name"}</h3>
                        <p><strong>Email:</strong> ${user.email}</p>
                        <p><strong>Role:</strong> ${user.role}</p>
                    `;
                    const roleSelect = document.createElement("select");
                    roleSelect.innerHTML = `
                        <option value="user">User</option>
                        <option value="admin">Admin</option>
                    `;
                    roleSelect.value = user.role;
                    const changeButton = document.createElement("button");
                    changeButton.textContent = "Change Role";
                    changeButton.addEventListener("click", async () => {
                        try {
                            const response = await fetch(
                                `/admin/users/${user._id}/role`,
                                {
                                    method: "PATCH",
                                    headers: {
                                        "Content-Type": "application/json"
                                    },
                                    credentials: "same-origin",
                                    body: JSON.stringify({
                                        newRole: roleSelect.value
                                    })
                                }
                            );
                            const result = await response.json();
                            if (!response.ok) {
                                throw new Error(
                                    result.message || "Role update failed"
                                );
                            }
                            alert(result.message || "Role updated successfully!");
                            await loadUsers();
                        } catch (error) {
                            alert(error.message);
                        }
                    });
                    // Delete User button
                    const deleteButton = document.createElement("button");
                    deleteButton.textContent = "Delete User";
                    deleteButton.className = "danger";
                    deleteButton.addEventListener("click", () => {
                        deleteUser(user._id);
                    });
                    userCard.append(
                        roleSelect,
                        changeButton,
                        deleteButton
                    );
                    usersList.appendChild(userCard);
                });

            } catch (error) {
                console.error("Load users error:", error);
                alert(error.message);
            }
        }

        // DELETE: Delete a user
        async function deleteUser(userId) {
            const confirmDelete = confirm(
                "Are you sure you want to delete this user?"
            );

            if (!confirmDelete) {
                return;
            }

            try {
                const response = await fetch(`/admin/users/${userId}`, {
                    method: "DELETE",
                    credentials: "same-origin"
                });

                const result = await response.json();

                if (!response.ok) {
                    throw new Error(result.message || "Failed to delete user");
                }

                alert(result.message);
                await loadUsers();

            } catch (error) {
                alert(error.message);
            }
        }
        manageUsers.addEventListener("click", loadUsers);
        document.getElementById("logout").addEventListener("click", async () => {
            try {
                const response = await fetch("/auth/logout", {
                    method: "POST",
                    credentials: "same-origin"
                });
                const data = await response.json();
                if (!response.ok) {
                    throw new Error(data.message || "Logout failed");
                }
                alert(data.message);
                window.location.href = "/login";
            } catch (error) {
                console.error("Logout error:", error);
                alert(error.message);
            }
        });
    </script>
</body>
</html>
