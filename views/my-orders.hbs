
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Orders</title>

    <style>
       
* {
    box-sizing: border-box;
}
body {
    margin: 0;
    padding: 35px 20px;
    font-family: 'Segoe UI', Arial, sans-serif;
    background: #f2f6f7;
    color: #24343a;
}
h1 {
    text-align: center;
    font-size: 32px;
    color: #164e55;
    margin: 10px 0 25px;
    font-weight: 700;
}
.top-buttons {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 30px;
}
button {
    padding: 11px 20px;
    border: none;
    background: #176b70;
    color: white;
    border-radius: 7px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    transition: background 0.2s ease, transform 0.2s ease;
}

button:hover {
    background: #104e53;
    transform: translateY(-2px);
}

/* Orders container */
#ordersContainer {
    max-width: 950px;
    margin: 0 auto;
}

/* Individual order card */
.order-card {
    background: #ffffff;
    padding: 25px;
    margin-bottom: 24px;
    border-radius: 12px;
    border: 1px solid #e1e9ea;
    border-left: 5px solid #176b70;
    box-shadow: 0 4px 15px rgba(25, 65, 70, 0.07);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.order-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 22px rgba(25, 65, 70, 0.12);
}

.order-card h3 {
    margin: 0 0 12px;
    color: #164e55;
    font-size: 19px;
    overflow-wrap: anywhere;
}

.order-card h4 {
    margin: 22px 0 10px;
    color: #176b70;
    font-size: 16px;
}

.order-card p {
    color: #5d6b70;
    line-height: 1.7;
    margin: 8px 0;
}

/* Product details */
.order-item {
    background: #f5f9f9;
    border: 1px solid #e5eeee;
    border-radius: 7px;
    padding: 12px 15px;
    margin: 9px 0;
    color: #34494e;
    font-size: 14px;
    line-height: 1.6;
}

/* Total amount */
.order-card h3:nth-of-type(2) {
    color: #14734f;
    font-size: 21px;
    margin-top: 20px;
    padding-top: 15px;
    border-top: 1px solid #e6eeee;
}

/* Order status */
.status {
    display: inline-block;
    padding: 7px 13px;
    background: #e3f5ec;
    color: #187448 !important;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 700;
    margin-top: 10px !important;
}

/* Loading and empty messages */
#ordersContainer:empty {
    display: none;
}

.empty-message {
    text-align: center;
    padding: 45px 20px;
    background: white;
    border-radius: 12px;
    color: #647579;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.05);
}
.order-item {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 15px;
    margin: 15px 0;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
}

.order-product-image {
    width: 130px;
    height: 130px;
    object-fit: contain;
    padding: 8px;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    flex-shrink: 0;
    transition: transform 0.3s ease;
}

.order-product-image:hover {
    transform: scale(1.05);
}

.order-item-details {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.order-item-details h4 {
    margin: 0 0 5px;
    font-size: 17px;
    color: #1e293b;
}

.order-item-details p {
    margin: 0;
    color: #64748b;
    font-size: 14px;
}

@media (max-width: 600px) {
    .order-item {
        gap: 12px;
        padding: 10px;
    }

    .order-product-image {
        width: 95px;
        height: 95px;
    }
}
/* Mobile responsive */
@media (max-width: 600px) {
    body {
        padding: 20px 12px;
    }

    h1 {
        font-size: 26px;
    }

    .order-card {
        padding: 18px;
    }

    .top-buttons {
        gap: 8px;
    }

    button {
        padding: 10px 13px;
        font-size: 13px;
    }
}
.cancel-order-btn {
    background: #dc3545;
    color: white;
    padding: 10px 18px;
    border: none;
    border-radius: 6px;
    margin-top: 15px;
    cursor: pointer;
    font-weight: 600;
}

.cancel-order-btn:hover {
    background: #b02a37;
}

.cancelled-status {
    background: #fde8e8;
    color: #c62828 !important;
}

    </style>
</head>

<body>

    <h1>My Orders</h1>

    <div class="top-buttons">
        <button onclick="fetchOrders()">Refresh Orders</button>
        <button onclick="window.location.href='/product-page'">
            Continue Shopping
        </button>
    </div>
    <div id="ordersContainer">
        Loading your orders...
    </div>
    <script>
        const ordersContainer = document.getElementById("ordersContainer");
        async function fetchOrders() {
            try {
                ordersContainer.textContent = "Loading your orders...";
                const response = await fetch("/orders/my-orders", {
                    method: "GET",
                    credentials: "include"
                });
                const data = await response.json();
                if (!response.ok) {
                    throw new Error(
                        data.message || "Failed to fetch orders"
                    );
                }
                displayOrders(data.orders);
            } catch (error) {
                ordersContainer.textContent = error.message;
            }
        }
function displayOrders(orders) {
    ordersContainer.replaceChildren();

    if (!orders || orders.length === 0) {
        ordersContainer.textContent = "You haven't placed any orders yet.";
        return;
    }

    orders.forEach(order => {
        const card = document.createElement("div");
        card.className = "order-card";
        const heading = document.createElement("h3");
        heading.textContent = `Order ID: ${order._id}`;
        const date = document.createElement("p");
        date.textContent =
            `Order Date: ${new Date(order.createdAt).toLocaleString()}`;
        card.append(heading, date);
        const productsHeading = document.createElement("h4");
        productsHeading.textContent = "Products";
        card.appendChild(productsHeading);
        order.items.forEach(item => {
            const itemDiv = document.createElement("div");
            itemDiv.className = "order-item";
            const image = document.createElement("img");
            const imagePath = item.product?.images?.[0];

                image.src = imagePath
                    ? `/${imagePath.replace(/^\/+/, "")}`
                    : "/images/no-image.png";

                image.alt = item.name;
                image.className = "order-product-image";

                image.onerror = function () {
                    console.log("Image not found:", this.src);
                    this.src = "/images/no-image.png";
                };
            const details = document.createElement("div");
            details.className = "order-item-details";

            const name = document.createElement("h4");
            name.textContent = item.name;

            const price = document.createElement("p");
            price.textContent = `Price: ₹${item.price}`;

            const quantity = document.createElement("p");
            quantity.textContent = `Quantity: ${item.quantity}`;

            details.append(name, price, quantity);
            itemDiv.append(image, details);

            card.appendChild(itemDiv);
        });

        // Total Amount
        const total = document.createElement("h3");
        total.textContent = `Total Amount: ₹${order.totalAmount}`;

        // Payment Details
        const payment = document.createElement("p");
        payment.textContent =
            `Payment: ${order.paymentMethod} - ${order.paymentStatus}`;

        // Order Status
        const status = document.createElement("p");
        status.className = "status";
        status.textContent = `Order Status: ${order.orderStatus}`;

        if (order.orderStatus === "CANCELLED") {
            status.classList.add("cancelled-status");
        }

        card.append(total, payment, status);

        // Cancel Order Button
        if (
            order.orderStatus === "PENDING" ||
            order.orderStatus === "CONFIRMED"
        ) {
            const cancelButton = document.createElement("button");

            cancelButton.textContent = "Cancel Order";
            cancelButton.className = "cancel-order-btn";

            cancelButton.addEventListener("click", () => {
                cancelOrder(order._id);
            });

            card.appendChild(cancelButton);
        }

        // Delivery Address
        const addressHeading = document.createElement("h4");
        addressHeading.textContent = "Delivery Address";
        card.appendChild(addressHeading);

        const address = order.shippingAddress;

        const addressDetails = document.createElement("p");
        addressDetails.textContent =
            `${address.fullName}, ${address.phone}, ` +
            `${address.addressLine}, ${address.city}, ` +
            `${address.state} - ${address.pincode}`;

        card.appendChild(addressDetails);

        ordersContainer.appendChild(card);
    });
}
        async function cancelOrder(orderId) {
       const confirmCancel = confirm(
        "Are you sure you want to cancel this order?"
    );
    if (!confirmCancel) {
        return;
    }
    try {
        const response = await fetch(
            `/orders/${orderId}/cancel`,
            {
                method: "PATCH",
                credentials: "include"
            }
        );

        const data = await response.json();

        if (!response.ok) {
            throw new Error(
                data.message || "Failed to cancel order"
            );
        }

        alert("Order cancelled successfully!");

        await fetchOrders();

    } catch (error) {
        alert(error.message);
    }
}
        fetchOrders();
    </script>

</body>
</html>
